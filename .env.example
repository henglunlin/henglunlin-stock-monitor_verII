# 後端環境變數範本。複製成 .env 後填入實際值。
# 正式環境請設在 Render 的 Environment 分頁，不要 commit .env。

# --- 富邦（只放憑證，帳密由前端手動輸入）---
FUBON_PFX_BASE64=

# --- 存取控制（Render 網址是公開的，這道防線必須有）---
APP_SHARED_TOKEN=
ALLOWED_ORIGINS=http://localhost:5173

# --- Telegram（選用）---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- GitHub（分組同步用，選用）---
GITHUB_TOKEN=
GITHUB_OWNER=henglunlin
GITHUB_REPO=henglunlin-stock-monitor-FUBAN
GITHUB_BRANCH=main
